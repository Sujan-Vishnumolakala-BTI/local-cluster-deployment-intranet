# ============================================================
# Example Terraform Variables
# ============================================================

aws_region = "ap-south-1"

project_name = "local-kubernetes"

vpc_cidr = "10.0.0.0/16"

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24",
  "10.0.3.0/24"
]

availability_zones = [
  "ap-south-1a",
  "ap-south-1b",
  "ap-south-1c"
]

# ------------------------------------------------------------
# Restrict these in an actual deployment.
# ------------------------------------------------------------

allowed_api_cidrs = [
  "YOUR_TRUSTED_NETWORK/32"
]

allowed_ssh_cidrs = [
  "YOUR_PUBLIC_IP/32"
]
